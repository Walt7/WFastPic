<Project Sdk="Microsoft.NET.Sdk">

  <!-- Server MCP (stdio) per cercare nelle foto già catalogate e preparare pacchetti da condividere.
       Legge i sidecar e persone.db in sola lettura: nessuna dipendenza da WinUI, funziona anche con l'app chiusa. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WFastPic.Mcp</RootNamespace>
    <AssemblyName>WFastPic.Mcp</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
