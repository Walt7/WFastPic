<Application
    x:Class="WFastPic.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Palette comune: Mica per barra del titolo, pannello cartelle e barra strumenti; la griglia
                sta su una "card" più scura con l'angolo arrotondato, come le app di Windows 11 (Foto, Esplora file).
                Le foto si giudicano meglio su un fondo scuro e neutro.
            -->
            <SolidColorBrush x:Key="SfondoContenutoBrush" Color="#141414" />
            <SolidColorBrush x:Key="BordoContenutoBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="SfondoCellaBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="SfondoViewerBrush" Color="#111111" />
            <SolidColorBrush x:Key="SfondoPannelloEditorBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="TestoSecondarioBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="TestoTerziarioBrush" Color="#7A7A7A" />
            <SolidColorBrush x:Key="TitoloSezioneBrush" Color="#9FC3E7" />

            <!-- Pulsanti della barra strumenti: senza riquadro finché non ci passa sopra il mouse. -->
            <Style x:Key="BarraButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinHeight" Value="34" />
            </Style>
            <Style x:Key="BarraToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinHeight" Value="34" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
