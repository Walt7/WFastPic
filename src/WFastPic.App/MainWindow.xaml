<Window
    x:Class="WFastPic.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WFastPic.App">

    <!--
        Pannello cartelle stile Picasa: fisso accanto alla griglia (Inline), "le mie cartelle" per anno
        con numero di foto e periodo; "Sfoglia il PC" è secondario e si carica solo se aperto.
    -->
    <SplitView
        x:Name="RootSplitView"
        DisplayMode="Inline"
        OpenPaneLength="290"
        IsPaneOpen="True"
        PanePlacement="Left"
        PaneBackground="#1E1E1E">

        <SplitView.Pane>
            <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0,10,0,0">
                <!--
                    Persone stile Picasa (opzione: riconoscimento pesante, chiesto al primo uso): chi compare
                    nella cartella e i gruppi di volti simili senza nome. Clic = filtra la griglia;
                    tasto destro = dai un nome, conferma le proposte, rinomina, togli il nome, ignora.
                -->
                <Expander
                    x:Name="PersoneExpander"
                    Grid.Row="0"
                    IsExpanded="True"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Persone" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleSwitch
                                x:Name="RiconoscimentoPersoneSwitch"
                                Grid.Column="1"
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                Toggled="RiconoscimentoPersoneSwitch_Toggled"
                                ToolTipService.ToolTip="Riconoscimento delle persone (analisi in background)" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="PersoneStatoText" Foreground="#888888" FontSize="12" TextWrapping="Wrap" />
                        <Grid x:Name="PersoneAnnullaPanel" ColumnDefinitions="*,Auto" ColumnSpacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="PersoneAnnullaText" Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <HyperlinkButton Grid.Column="1" Content="Annulla" FontSize="12" Padding="0" Click="PersoneAnnulla_Click" />
                        </Grid>
                        <!--
                            Come l'elenco Persone di Picasa: tutte le persone con nome (di tutte le cartelle,
                            in ordine alfabetico) con miniatura quadrata e numero di foto, poi i gruppi senza
                            nome della cartella aperta. Chi non compare qui è attenuato: il clic apre la sua cartella.
                        -->
                        <ListView
                            x:Name="PersoneList"
                            MaxHeight="300"
                            Margin="-12,0,-12,0"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="PersoneList_ItemClick"
                            RightTapped="PersoneList_RightTapped">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:PersonaUi">
                                    <Grid Padding="0,4" ColumnDefinitions="Auto,*" ColumnSpacing="10" Opacity="{x:Bind Opacita}">
                                        <Border Width="40" Height="40" CornerRadius="4" Background="#2A2A2A">
                                            <Image Source="{x:Bind Avatar}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind Nome}" Foreground="{x:Bind ColoreNome}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Dettaglio}" Foreground="#999999" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <HyperlinkButton Content="Rianalizza le persone di questa cartella" FontSize="12" Padding="0" Click="RianalizzaPersone_Click" />
                    </StackPanel>
                </Expander>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="14,8,8,6">
                    <TextBlock Text="Cartelle" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="AggiungiCartellaButton_Click"
                        ToolTipService.ToolTip="Aggiungi una cartella di foto"
                        AutomationProperties.Name="Aggiungi una cartella di foto">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                </Grid>

                <Grid Grid.Row="2">
                    <ListView
                        x:Name="ElencoCartelle"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="ElencoCartelle_ItemClick"
                        Padding="0,0,0,8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="local:GruppoAnno">
                                        <TextBlock Text="{x:Bind Titolo}" Foreground="#9FC3E7" FontSize="18" FontWeight="SemiBold" Margin="2,6,0,0" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:VoceCartella">
                                <Grid Padding="6,6" CornerRadius="4" Opacity="{x:Bind Opacita}" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <!-- Cartella aperta adesso: fondo evidenziato, come la selezione di Picasa. -->
                                    <Border Grid.ColumnSpan="2" Margin="-6,-6" CornerRadius="4" Background="#2E4A66" Visibility="{x:Bind IsCorrente, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE8B7;" Foreground="#F2C14E" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{x:Bind Nome}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Dettaglio, Mode=OneWay}" Foreground="#AAAAAA" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Periodo}" Foreground="#888888" FontSize="11" TextTrimming="CharacterEllipsis" Visibility="{x:Bind PeriodoVisibile}" />
                                    </StackPanel>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout Opening="MenuCartella_Opening">
                                            <MenuFlyoutItem Text="Apri in Esplora file" Click="CartellaApriInEsplora_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xEC50;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Togli dall'elenco" Click="CartellaRimuoviDallElenco_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE711;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <ToolTipService.ToolTip>
                                        <TextBlock Text="{x:Bind Percorso}" />
                                    </ToolTipService.ToolTip>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="PannelloCartelleVuotoText"
                        Text="Nessuna cartella ancora. Usa + oppure &quot;Sfoglia il PC&quot; per aprirne una: comparirà qui, divisa per anno."
                        Foreground="#888888"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Margin="16,8"
                        Visibility="Collapsed" />
                </Grid>

                <Expander
                    x:Name="SfogliaPcExpander"
                    Grid.Row="3"
                    Header="Sfoglia il PC"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Expanding="SfogliaPcExpander_Expanding">
                    <TreeView
                        x:Name="DirectoryTree"
                        Height="280"
                        SelectionMode="None"
                        Expanding="DirectoryTree_Expanding"
                        ItemInvoked="DirectoryTree_ItemInvoked">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="TreeViewNode">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="2,4">
                                    <FontIcon Glyph="{x:Bind ((local:DirectoryTreeEntry)Content).Icona}" Foreground="#B8D8F5" FontSize="15" />
                                    <TextBlock Text="{x:Bind ((local:DirectoryTreeEntry)Content).Nome}" Foreground="#DDDDDD" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Expander>
            </Grid>
        </SplitView.Pane>

        <Grid RowDefinitions="Auto,*,Auto">

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="12,10" Background="#1A1A1A">
                <Button
                    x:Name="ToggleSidebarButton"
                    Width="40"
                    Height="36"
                    Padding="0"
                    Click="ToggleSidebarButton_Click"
                    ToolTipService.ToolTip="Mostra/nascondi il pannello cartelle"
                    AutomationProperties.Name="Mostra o nascondi il pannello cartelle">
                    <FontIcon Glyph="&#xE700;" FontSize="18" />
                </Button>
                <Button x:Name="ApriCartellaButton" Content="Apri cartella…" Click="ApriCartellaButton_Click" />
                <TextBox
                    x:Name="PercorsoTextBox"
                    Width="380"
                    PlaceholderText="Incolla o scrivi il percorso della cartella, poi Invio…"
                    KeyDown="PercorsoTextBox_KeyDown" />
                <Button x:Name="GestisciScartiButton" Content="Gestisci scarti…" Click="GestisciScartiButton_Click" />
                <Button x:Name="EsportaButton" Content="Esporta…" Click="EsportaButton_Click" />
                <Button x:Name="MappaButton" Content="📍 Mappa" Click="MappaButton_Click" ToolTipService.ToolTip="Visualizza le foto geolocalizzate sulla mappa" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="White" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Filtro:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox
                        x:Name="FiltroComboBox"
                        SelectedIndex="0"
                        SelectionChanged="FiltroComboBox_SelectionChanged">
                        <ComboBoxItem Content="Tutte" />
                        <ComboBoxItem Content="Selezionate" />
                        <ComboBoxItem Content="Scarti" />
                        <ComboBoxItem Content="Geolocalizzate" />
                        <ComboBoxItem Content="Con volti" />
                    </ComboBox>
                    <Button
                        x:Name="FiltroPersonaButton"
                        Margin="12,0,0,0"
                        Visibility="Collapsed"
                        Click="FiltroPersonaButton_Click"
                        ToolTipService.ToolTip="Togli il filtro persona">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                            <TextBlock x:Name="FiltroPersonaText" />
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        x:Name="DividiPerGiorniToggle"
                        Margin="12,0,0,0"
                        Click="DividiPerGiorniToggle_Click"
                        IsTabStop="False"
                        AllowFocusOnInteraction="False"
                        ToolTipService.ToolTip="Divide la griglia per giorno di scatto">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE787;" FontSize="14" />
                            <TextBlock Text="Per giorni" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </StackPanel>

        <ListView
            x:Name="Griglia"
            Grid.Row="1"
            SelectionMode="Single"
            IsItemClickEnabled="False"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Visible"
            ScrollViewer.VerticalScrollMode="Enabled"
            SelectionChanged="Griglia_SelectionChanged"
            DoubleTapped="Griglia_DoubleTapped"
            ContainerContentChanging="Griglia_ContainerContentChanging"
            Loaded="Griglia_Loaded">
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemSelectedBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemSelectedPointerOverBackground" Color="#22FFFFFF" />
                <SolidColorBrush x:Key="ListViewItemSelectedPressedBackground" Color="#33FFFFFF" />
            </ListView.Resources>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="160" ItemHeight="160" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <!-- Usato solo con "Dividi per giorni" (sorgente raggruppata): intestazione per data come Picasa. -->
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="local:GruppoGiorno">
                            <TextBlock Text="{x:Bind Titolo, Mode=OneWay}" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="2,10,0,2" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PhotoGridItem">
                    <Grid Margin="4">
                        <!-- Image dentro il Border: il CornerRadius ritaglia anche la miniatura, non solo lo sfondo. -->
                        <Border Background="#2A2A2A" CornerRadius="4">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                        </Border>
                        <Border Background="#66000000" Visibility="{x:Bind IsReject, Mode=OneWay}" />
                        <Border
                            BorderBrush="#FFD600"
                            BorderThickness="5"
                            Background="#22FFD600"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                        <Border
                            Height="4"
                            VerticalAlignment="Bottom"
                            CornerRadius="0,0,4,4"
                            Background="LimeGreen"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind IsCorrenteGriglia, Mode=OneWay}" />
                        <Border
                            x:Name="SelectionBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            Tapped="SelectionBadge_Tapped"
                            DoubleTapped="SelectionBadge_DoubleTapped">
                            <FontIcon
                                Glyph="&#xE73E;"
                                Foreground="LimeGreen"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                        </Border>
                        <FontIcon
                            Glyph="&#xE711;"
                            Foreground="OrangeRed"
                            FontSize="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="6"
                            Visibility="{x:Bind IsReject, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind RatingTesto, Mode=OneWay}"
                            Foreground="Gold"
                            FontSize="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="6"
                            Visibility="{x:Bind HasRating, Mode=OneWay}" />
                        <Border
                            Width="4"
                            HorizontalAlignment="Left"
                            CornerRadius="4,0,0,4"
                            Background="#00B0FF"
                            Visibility="{x:Bind HasGroup, Mode=OneWay}" />
                        <!-- Orientamento dalla miniatura: badge nelle bande vuote, non sopra la foto. -->
                        <StackPanel Orientation="{x:Bind OrientamentoBadge, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2" Spacing="3">
                            <!-- Stesso riquadro scuro del badge GPS: un'icona bianca nuda sparisce su cieli e spiagge. -->
                            <Border
                                Background="#B3000000"
                                CornerRadius="3"
                                Padding="3,2"
                                Visibility="{x:Bind HasVideo, Mode=OneWay}"
                                ToolTipService.ToolTip="Live Photo: video abbinato (.mov/.mp4)">
                                <FontIcon Glyph="&#xE714;" Foreground="White" FontSize="12" />
                            </Border>
                            <Border
                                Background="#B3000000"
                                CornerRadius="3"
                                Padding="3,2"
                                Visibility="{x:Bind HasGps, Mode=OneWay}"
                                ToolTipService.ToolTip="Foto con coordinate GPS">
                                <FontIcon Glyph="&#xE707;" Foreground="#4FC3F7" FontSize="12" />
                            </Border>
                            <!-- Modifiche fatte nell'editor: ritaglio, raddrizzamento, colore/tono. -->
                            <Border
                                Background="#B3000000"
                                CornerRadius="3"
                                Padding="3,2"
                                Visibility="{x:Bind HaModifiche, Mode=OneWay}"
                                ToolTipService.ToolTip="Foto modificata (ritaglio, raddrizzamento, colore)">
                                <StackPanel Orientation="{x:Bind OrientamentoBadge, Mode=OneWay}" Spacing="4">
                                    <FontIcon Glyph="&#xE7A8;" Foreground="#FFB300" FontSize="12" Visibility="{x:Bind HaRitaglio, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE7AD;" Foreground="#FFB300" FontSize="12" Visibility="{x:Bind HaRaddrizzamento, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE790;" Foreground="#FF80AB" FontSize="12" Visibility="{x:Bind HaTono, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border
                            Background="#CC000000"
                            CornerRadius="3"
                            Padding="4,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="6"
                            Visibility="{x:Bind HasGroup, Mode=OneWay}">
                            <TextBlock Text="{x:Bind GruppoTesto, Mode=OneWay}" Foreground="#00B0FF" FontSize="12" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="12,8" Background="#1A1A1A">
            <TextBlock
                Text="←/→ naviga · Space seleziona · Shift+Space seleziona e scarta il resto della raffica · Delete scarta · 0-5 rating · Tab filtro · Ctrl+A seleziona visibili · Shift+rotella dimensione griglia · Enter apri viewer"
                Foreground="#888888"
                FontSize="12"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />
            <!-- Come Picasa: la griglia è già usabile mentre le miniature arrivano, l'avanzamento sta in basso. -->
            <StackPanel
                x:Name="MiniaturePanel"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10"
                Margin="16,0,0,0"
                Visibility="Collapsed">
                <TextBlock x:Name="MiniatureText" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center" />
                <ProgressBar x:Name="MiniatureProgressBar" Width="220" Minimum="0" Maximum="1" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="ViewerOverlay"
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#F0101010"
            Visibility="Collapsed"
            IsTabStop="True"
            RowDefinitions="Auto,*,Auto,Auto">

            <StackPanel x:Name="ViewerBarraSuperiore" Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="12" Background="#1A1A1A">
                <Button x:Name="ViewerCloseButton" Content="← Chiudi (Esc)" Click="ViewerCloseButton_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                <Button x:Name="ViewerGrigliaToggle" Content="Griglia: terzi" Click="ViewerGrigliaToggle_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                <TextBlock x:Name="ViewerZoomText" Text="Zoom 100%" Foreground="#AAAAAA" VerticalAlignment="Center" Width="82" />
                <TextBlock x:Name="ViewerStatusText" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="16,0,0,0" />
                <StackPanel x:Name="ViewerVideoBadge" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE714;" Foreground="#FFB300" FontSize="16" />
                    <TextBlock Text="ha un video abbinato" Foreground="#FFB300" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="260,*">

                <!-- Pannello editor stile Picasa: "Correzioni base" e "Regolazioni". -->
                <ScrollViewer Grid.Column="0" Background="#1A1A1A" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                    <StackPanel Padding="12" Spacing="8">
                        <!-- Nel pannello e non nella barra in alto: a schermo intero la barra sparisce, il pulsante resta. -->
                        <ToggleButton x:Name="ViewerSchermoInteroToggle" HorizontalAlignment="Stretch" Click="ViewerSchermoIntero_Click" IsTabStop="False" AllowFocusOnInteraction="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE740;" FontSize="14" />
                                <TextBlock Text="Schermo intero (F11)" />
                            </StackPanel>
                        </ToggleButton>
                        <TextBlock x:Name="ViewerPosizioneSchermoInteroText" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <ToggleButton x:Name="ViewerTabBase" Grid.Column="0" Content="Correzioni base" IsChecked="True" HorizontalAlignment="Stretch" Click="ViewerTabBase_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                            <ToggleButton x:Name="ViewerTabTuning" Grid.Column="1" Content="Regolazioni" HorizontalAlignment="Stretch" Click="ViewerTabTuning_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                        </Grid>

                        <!-- Modalita geometria: ritaglia + raddrizza con Applica/Annulla. -->
                        <StackPanel x:Name="PannelloGeometria" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="Ritaglia e raddrizza" Foreground="White" FontWeight="SemiBold" />
                            <Button x:Name="ViewerProporzioneToggle" Content="Proporzioni: libera" Click="ViewerProporzioneToggle_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" />
                            <TextBlock Text="Raddrizza (L)" Foreground="#CCCCCC" FontSize="12" />
                            <Grid ColumnDefinitions="*,48">
                                <Slider
                                    x:Name="ViewerStraightenSlider"
                                    Minimum="-15" Maximum="15" StepFrequency="0.1"
                                    IsTabStop="False"
                                    ValueChanged="ViewerStraightenSlider_ValueChanged" />
                                <TextBlock x:Name="ViewerAngleText" Grid.Column="1" Text="0.0°" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Button Grid.Column="0" Content="Applica (Invio)" Click="ViewerGeometriaApplica_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" IsTabStop="False" AllowFocusOnInteraction="False" />
                                <Button Grid.Column="1" Content="Annulla (Esc)" Click="ViewerGeometriaAnnulla_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" />
                            </Grid>

                            <!-- Come Picasa: ritagli già pronti come miniature; un clic posiziona il riquadro. -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <TextBlock Text="Ritagli suggeriti" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center" />
                                <ProgressRing x:Name="ViewerSuggerimentiAnello" Grid.Column="1" Width="14" Height="14" IsActive="False" />
                            </Grid>
                            <GridView
                                x:Name="ViewerSuggerimentiList"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="ViewerSuggerimento_ItemClick"
                                IsTabStop="False"
                                AllowFocusOnInteraction="False">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:SuggerimentoRitaglioUi">
                                        <StackPanel Width="108" Spacing="2" Padding="0,2">
                                            <Border Height="76" Background="#2A2A2A" CornerRadius="3">
                                                <Image Source="{x:Bind Anteprima}" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Etichetta}" Foreground="#CCCCCC" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <TextBlock x:Name="ViewerSuggerimentiVolti" Foreground="#888888" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel x:Name="PannelloBase" Spacing="8">
                            <Button x:Name="ViewerCropButton" Content="Ritaglia (X)" Click="ViewerCropButton_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" />
                            <Button x:Name="ViewerStraightenButton" Content="Raddrizza (L)" Click="ViewerStraightenButton_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" />
                            <ToggleButton x:Name="ViewerLuckyToggle" Content="Ho fortuna (U)" Click="ViewerLuckyToggle_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" />
                            <ToggleButton x:Name="ViewerAutoContrastToggle" Content="Auto contrasto" Click="ViewerAutoContrastToggle_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" />
                            <ToggleButton x:Name="ViewerAutoColorToggle" Content="Auto colore" Click="ViewerAutoColorToggle_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" />
                        </StackPanel>

                        <StackPanel x:Name="PannelloTuning" Spacing="4" Visibility="Collapsed">
                            <Grid ColumnDefinitions="*,44">
                                <TextBlock Text="Luce di riempimento" Foreground="#CCCCCC" FontSize="12" />
                                <TextBlock x:Name="ViewerFillLightText" Grid.Column="1" Text="0" Foreground="White" FontSize="12" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="ViewerFillLightSlider" Minimum="0" Maximum="100" StepFrequency="1" IsTabStop="False" ValueChanged="ViewerTuningSlider_ValueChanged" />
                            <Grid ColumnDefinitions="*,44">
                                <TextBlock Text="Evidenzia (alte luci)" Foreground="#CCCCCC" FontSize="12" />
                                <TextBlock x:Name="ViewerHighlightsText" Grid.Column="1" Text="0" Foreground="White" FontSize="12" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="ViewerHighlightsSlider" Minimum="0" Maximum="100" StepFrequency="1" IsTabStop="False" ValueChanged="ViewerTuningSlider_ValueChanged" />
                            <Grid ColumnDefinitions="*,44">
                                <TextBlock Text="Ombre" Foreground="#CCCCCC" FontSize="12" />
                                <TextBlock x:Name="ViewerShadowsText" Grid.Column="1" Text="0" Foreground="White" FontSize="12" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="ViewerShadowsSlider" Minimum="0" Maximum="100" StepFrequency="1" IsTabStop="False" ValueChanged="ViewerTuningSlider_ValueChanged" />
                            <Grid ColumnDefinitions="*,44">
                                <TextBlock Text="Temperatura colore" Foreground="#CCCCCC" FontSize="12" />
                                <TextBlock x:Name="ViewerTemperatureText" Grid.Column="1" Text="0" Foreground="White" FontSize="12" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="ViewerTemperatureSlider" Minimum="-100" Maximum="100" StepFrequency="1" IsTabStop="False" ValueChanged="ViewerTuningSlider_ValueChanged" />
                            <Button Content="Azzera regolazioni" Click="ViewerTuningReset_Click" HorizontalAlignment="Stretch" Margin="0,6,0,0" IsTabStop="False" AllowFocusOnInteraction="False" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="#333333" Margin="0,6" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Button x:Name="ViewerUndoButton" Grid.Column="0" Content="↶ Annulla" Click="ViewerUndo_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" />
                            <Button x:Name="ViewerRedoButton" Grid.Column="1" Content="Ripeti ↷" Click="ViewerRedo_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" />
                        </Grid>
                        <Button x:Name="ViewerResetButton" Content="Ripristina originale" Click="ViewerReset_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" />
                        <TextBlock Text="Tieni premuto B per vedere l'originale" Foreground="#777777" FontSize="11" TextWrapping="Wrap" />

                        <!--
                            Luogo, come il pannello "Luoghi" di Picasa: nome del posto, dispositivo e dati
                            di ripresa (altitudine, direzione, drone), mini-mappa con la freccia della
                            direzione. "Correggi" sposta il segnaposto; la correzione sta solo nel sidecar.
                        -->
                        <StackPanel x:Name="PannelloLuogo" Spacing="6" Margin="0,6,0,0">
                            <Rectangle Height="1" Fill="#333333" Margin="0,0,0,4" />
                            <TextBlock Text="Luogo" Foreground="White" FontWeight="SemiBold" />
                            <TextBlock x:Name="ViewerLuogoNome" Foreground="#DDDDDD" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="ViewerLuogoDettagli" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap" />
                            <Border CornerRadius="4" Height="170" Background="#222222">
                                <WebView2 x:Name="ViewerMiniMappa" />
                            </Border>
                            <TextBlock x:Name="ViewerLuogoSuggerimento" Text="Trascina il segnaposto o clicca sulla mappa nel punto giusto." Foreground="#FFB300" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                            <Grid x:Name="ViewerLuogoAzioni" ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Button x:Name="ViewerLuogoCorreggiButton" Content="Correggi" HorizontalAlignment="Stretch" Click="ViewerLuogoCorreggi_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                                <Button x:Name="ViewerLuogoRimuoviButton" Grid.Column="1" Content="Rimuovi" HorizontalAlignment="Stretch" Click="ViewerLuogoRimuovi_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                            </Grid>
                            <Grid x:Name="ViewerLuogoModifica" ColumnDefinitions="*,*" ColumnSpacing="6" Visibility="Collapsed">
                                <Button Content="Salva" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="ViewerLuogoSalva_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                                <Button Grid.Column="1" Content="Annulla" HorizontalAlignment="Stretch" Click="ViewerLuogoAnnulla_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                            </Grid>
                            <Button x:Name="ViewerLuogoRipristinaButton" Content="Ripristina la posizione del file" HorizontalAlignment="Stretch" Click="ViewerLuogoRipristina_Click" Visibility="Collapsed" IsTabStop="False" AllowFocusOnInteraction="False" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Background trasparente: tutta l'area (anche fuori dalla foto) riceve trascinamento e rotella. -->
                <Grid
                    x:Name="ViewerArea"
                    Grid.Column="1"
                    Background="Transparent"
                    SizeChanged="ViewerArea_SizeChanged"
                    PointerPressed="ViewerArea_PointerPressed"
                    PointerMoved="ViewerArea_PointerMoved"
                    PointerReleased="ViewerArea_PointerReleased"
                    PointerCaptureLost="ViewerArea_PointerReleased">
                    <Grid x:Name="ViewerImageContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="ViewerImageHost">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ViewerZoomTransform" ScaleX="1" ScaleY="1" />
                                    <RotateTransform x:Name="ViewerRotateTransform" Angle="0" />
                                    <!-- Trascinamento quando è zoomata (pixel schermo, applicato dopo lo zoom). -->
                                    <TranslateTransform x:Name="ViewerPanTransform" X="0" Y="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
                            <Image x:Name="ViewerImage" Stretch="Fill" />
                            <Border
                                x:Name="ViewerSelectionBorder"
                                BorderBrush="#FFD600"
                                BorderThickness="4"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        </Grid>
                        <Canvas x:Name="ViewerCropCanvas" Background="Transparent">
                            <Rectangle x:Name="DimTop" Fill="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />
                            <Rectangle x:Name="DimBottom" Fill="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />
                            <Rectangle x:Name="DimLeft" Fill="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />
                            <Rectangle x:Name="DimRight" Fill="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />
                            <Rectangle x:Name="ThirdsV1" Width="1" Fill="#88FFFFFF" IsHitTestVisible="False" />
                            <Rectangle x:Name="ThirdsV2" Width="1" Fill="#88FFFFFF" IsHitTestVisible="False" />
                            <Rectangle x:Name="ThirdsH1" Height="1" Fill="#88FFFFFF" IsHitTestVisible="False" />
                            <Rectangle x:Name="ThirdsH2" Height="1" Fill="#88FFFFFF" IsHitTestVisible="False" />
                            <Line x:Name="DiagLine1" Stroke="#88FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                            <Line x:Name="DiagLine2" Stroke="#88FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                            <Border x:Name="CropRectBorder" Tag="M" BorderBrush="#FFB300" BorderThickness="2" Background="#11FFB300" Visibility="Collapsed" />
                        </Canvas>
                        <!-- Come nella griglia: icona video sull'angolo della foto, riquadro scuro per restare leggibile. -->
                        <Border
                            x:Name="ViewerFotoVideoBadge"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10"
                            Padding="6,4"
                            CornerRadius="4"
                            Background="#B3000000"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <FontIcon Glyph="&#xE714;" Foreground="White" FontSize="18" />
                        </Border>
                    </Grid>
                </Grid>

                <!--
                    Correzione della posizione a mappa grande (al posto della foto): mappa o satellite,
                    zoom da strada, segnaposto trascinabile o clic nel punto giusto. Salva/Annulla in alto.
                -->
                <Grid x:Name="ViewerMappaGrandeOverlay" Grid.Column="1" Background="#101010" RowDefinitions="Auto,*" Visibility="Collapsed">
                    <Grid Background="#1A1A1A" Padding="12,8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Correggi la posizione" Foreground="White" FontWeight="SemiBold" />
                            <TextBlock x:Name="ViewerMappaGrandeInfo" Text="Trascina il segnaposto o clicca nel punto giusto. In alto a destra: mappa o satellite." Foreground="#AAAAAA" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Salva posizione" Style="{StaticResource AccentButtonStyle}" Click="ViewerLuogoSalva_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                        <Button Grid.Column="2" Content="Annulla (Esc)" Click="ViewerLuogoAnnulla_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                    </Grid>
                    <WebView2 x:Name="ViewerMappaGrande" Grid.Row="1" />
                </Grid>
            </Grid>

            <!--
                Filmstrip stile Picasa: la foto in osservazione è sempre al centro (Padding calcolato in
                AggiornaFilmstrip), più grande, a piena opacità, con bordo bianco e la stessa linea verde
                "corrente" della griglia; le altre sono attenuate. Colori coerenti con la griglia:
                giallo = selezionata, azzurro a sinistra = stessa raffica, verde sotto = corrente.
                Niente scroll e niente focus: le frecce restano al viewer.
            -->
            <ListView
                x:Name="Filmstrip"
                Grid.Row="2"
                Height="136"
                Background="#141414"
                SelectionMode="None"
                IsTabStop="False"
                AllowFocusOnInteraction="False"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                IsItemClickEnabled="True"
                ItemClick="Filmstrip_ItemClick"
                SizeChanged="Filmstrip_SizeChanged">
                <ListView.ItemContainerStyle>
                    <!-- Contenitore senza padding/larghezza minima: il calcolo del centro usa le misure esatte. -->
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Bottom" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PhotoGridItem">
                        <StackPanel Margin="4,0" Spacing="3" VerticalAlignment="Bottom">
                            <Grid
                                Width="{x:Bind DimensioneFilmstrip, Mode=OneWay}"
                                Height="{x:Bind DimensioneFilmstrip, Mode=OneWay}"
                                Opacity="{x:Bind OpacitaFilmstrip, Mode=OneWay}">
                                <Border Background="#2A2A2A" CornerRadius="3">
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                </Border>
                                <Border BorderBrush="#FFD600" BorderThickness="3" CornerRadius="3" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                <Border Width="4" HorizontalAlignment="Left" CornerRadius="3,0,0,3" Background="#00B0FF" Visibility="{x:Bind EvidenziaGruppoViewer, Mode=OneWay}" />
                                <Border BorderBrush="White" BorderThickness="3" CornerRadius="3" Visibility="{x:Bind IsCorrenteViewer, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE73E;" Foreground="LimeGreen" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE711;" Foreground="OrangeRed" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Visibility="{x:Bind IsReject, Mode=OneWay}" />
                                <Border
                                    Background="#B3000000"
                                    CornerRadius="3"
                                    Padding="2,1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="6,0,0,4"
                                    Visibility="{x:Bind HasVideo, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE714;" Foreground="White" FontSize="10" />
                                </Border>
                                <!-- Modifiche: si aggiornano subito mentre si lavora sulla foto nell'editor. -->
                                <Border
                                    Background="#B3000000"
                                    CornerRadius="3"
                                    Padding="2,1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,6,4"
                                    Visibility="{x:Bind HaModifiche, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <FontIcon Glyph="&#xE7A8;" Foreground="#FFB300" FontSize="10" Visibility="{x:Bind HaRitaglio, Mode=OneWay}" />
                                        <FontIcon Glyph="&#xE7AD;" Foreground="#FFB300" FontSize="10" Visibility="{x:Bind HaRaddrizzamento, Mode=OneWay}" />
                                        <FontIcon Glyph="&#xE790;" Foreground="#FF80AB" FontSize="10" Visibility="{x:Bind HaTono, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- Spazio sempre riservato: le miniature restano allineate in basso con o senza linea. -->
                            <Grid Height="4">
                                <Border CornerRadius="2" Background="LimeGreen" Visibility="{x:Bind IsCorrenteViewer, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="ViewerHintText"
                Grid.Row="3"
                Foreground="#888888"
                FontSize="12"
                Padding="12,6"
                Text="←/→ foto · Space seleziona · Delete scarta · 0-5 rating · rotella zoom, trascina per spostare · X ritaglia · L raddrizza · U ho fortuna · Ctrl+Z/Y annulla/ripeti · B originale · Esc chiudi" />
        </Grid>

        <ContentDialog
            x:Name="DialogScarti"
            Grid.Row="0"
            Grid.RowSpan="3"
            Title="Gestisci scarti"
            CloseButtonText="Annulla"
            DefaultButton="Close">
            <StackPanel Spacing="12" MinWidth="360">
                <TextBlock x:Name="ScartiSummary" />
                <ListView x:Name="ScartiList" MaxHeight="300" SelectionMode="None" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CestinoButton" Content="Sposta nel Cestino" Click="CestinoButton_Click" />
                    <Button x:Name="SpostaInScartiButton" Content="Sposta in Scarti/" Click="SpostaInScartiButton_Click" />
                    <Button x:Name="LasciaButton" Content="Lascia (torna a Nessuno)" Click="LasciaButton_Click" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <!--
            Dialog "Esporta" sul modello di Picasa: posizione + nome della cartella esportata,
            dimensioni originali o "ridimensiona a" con slider in pixel, qualità a preset,
            filigrana. Le opzioni restano memorizzate tra un export e l'altro (ImpostazioniStore).
        -->
        <ContentDialog
            x:Name="DialogExport"
            Grid.Row="0"
            Grid.RowSpan="3"
            Title="Esporta foto"
            PrimaryButtonText="Esporta"
            CloseButtonText="Chiudi"
            DefaultButton="Primary"
            PrimaryButtonClick="DialogExport_PrimaryButtonClick"
            Closing="DialogExport_Closing">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620" Padding="0,0,14,0">
                <StackPanel Spacing="8" Width="440">
                    <TextBlock Text="Foto da esportare" FontWeight="SemiBold" />
                    <RadioButton x:Name="ExportAmbitoSelezionateRadio" GroupName="ExportAmbito" IsChecked="True" Checked="ExportOpzione_Changed" />
                    <RadioButton x:Name="ExportAmbitoTutteRadio" GroupName="ExportAmbito" Checked="ExportOpzione_Changed" />

                    <TextBlock Text="Posizione esportazione" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="ExportPosizioneTextBox" TextChanged="ExportPercorso_TextChanged" />
                        <Button Grid.Column="1" Content="Sfoglia…" Click="ExportScegliCartellaButton_Click" />
                    </Grid>
                    <TextBlock Text="Nome della cartella esportata" Foreground="#AAAAAA" FontSize="12" />
                    <TextBox x:Name="ExportNomeCartellaTextBox" TextChanged="ExportPercorso_TextChanged" />
                    <TextBlock x:Name="ExportDestinazioneText" Foreground="#888888" FontSize="11" TextWrapping="Wrap" />

                    <TextBlock Text="Dimensioni immagine" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <RadioButton x:Name="ExportOriginaleRadio" GroupName="ExportDimensioni" Content="Usa dimensioni originali" Checked="ExportOpzione_Changed" />
                    <RadioButton x:Name="ExportRidimensionaRadio" GroupName="ExportDimensioni" Content="Ridimensiona a (lato lungo):" IsChecked="True" Checked="ExportOpzione_Changed" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="28,0,0,0">
                        <Slider x:Name="ExportLatoSlider" Minimum="400" Maximum="6000" StepFrequency="16" SmallChange="16" LargeChange="400" Value="2048" ValueChanged="ExportLatoSlider_ValueChanged" VerticalAlignment="Center" />
                        <NumberBox x:Name="ExportLatoNumberBox" Grid.Column="1" Width="110" Minimum="200" Maximum="20000" Value="2048" SpinButtonPlacementMode="Compact" ValueChanged="ExportLatoNumberBox_ValueChanged" />
                        <TextBlock Grid.Column="2" Text="pixel" VerticalAlignment="Center" Foreground="#AAAAAA" />
                    </Grid>

                    <TextBlock Text="Qualità immagine" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <ComboBox x:Name="ExportQualitaCombo" Width="200" SelectedIndex="0" SelectionChanged="ExportOpzione_Changed">
                            <ComboBoxItem Content="Automatica (consigliata)" />
                            <ComboBoxItem Content="Massima" />
                            <ComboBoxItem Content="Normale" />
                            <ComboBoxItem Content="Minima" />
                            <ComboBoxItem Content="Personalizzata" />
                        </ComboBox>
                        <Slider x:Name="ExportQualitaSlider" Grid.Column="1" Minimum="40" Maximum="100" StepFrequency="1" Value="90" VerticalAlignment="Center" ValueChanged="ExportOpzione_Changed" />
                        <TextBlock x:Name="ExportQualitaText" Grid.Column="2" Width="40" VerticalAlignment="Center" Foreground="#AAAAAA" />
                    </Grid>

                    <TextBlock Text="Filigrana" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <CheckBox x:Name="ExportFiligranaCheck" Content="Aggiungi filigrana" Checked="ExportOpzione_Changed" Unchecked="ExportOpzione_Changed" />
                    <StackPanel x:Name="ExportFiligranaPanel" Spacing="8" Margin="28,0,0,0">
                        <TextBox x:Name="ExportWatermarkTextBox" PlaceholderText="es. © Mario Rossi" TextChanged="ExportPercorso_TextChanged" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="Opacità" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12" />
                            <Slider x:Name="ExportOpacitaSlider" Grid.Column="1" Minimum="10" Maximum="100" Value="50" VerticalAlignment="Center" />
                            <ComboBox x:Name="ExportPosizioneCombo" Grid.Column="2" SelectedIndex="3" Width="150">
                                <ComboBoxItem Content="Alto sinistra" />
                                <ComboBoxItem Content="Alto destra" />
                                <ComboBoxItem Content="Basso sinistra" />
                                <ComboBoxItem Content="Basso destra" />
                                <ComboBoxItem Content="Centro" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Altre opzioni" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox x:Name="ExportTagTextBox" Header="Tag (separati da virgola)" PlaceholderText="es. vacanza, puglia, 2026" />
                    <CheckBox x:Name="ExportRimuoviGpsCheck" Content="Rimuovi la posizione GPS dai file esportati" />
                    <CheckBox x:Name="ExportSostituisciCheck" Content="Sostituisci i file già esportati con lo stesso nome" IsChecked="True" />

                    <ProgressBar x:Name="ExportProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,8,0,0" />
                    <TextBlock x:Name="ExportStatusText" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" />
                    <ListView x:Name="ExportErroriList" MaxHeight="120" Visibility="Collapsed" SelectionMode="None" FontSize="12" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <Grid
            x:Name="CaricamentoOverlay"
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#B0101010"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="420">
                <TextBlock x:Name="CaricamentoText" Text="Caricamento…" Foreground="White" FontSize="16" HorizontalAlignment="Center" />
                <ProgressBar x:Name="CaricamentoProgressBar" IsIndeterminate="True" Minimum="0" Maximum="1" />
                <TextBlock x:Name="CaricamentoDettaglioText" Foreground="#AAAAAA" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="MapOverlay"
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#F0101010"
            Visibility="Collapsed"
            IsTabStop="True"
            RowDefinitions="Auto,*">

            <Grid Grid.Row="0" Background="#1A1A1A" Padding="12,10" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button x:Name="MapCloseButton" Content="← Chiudi mappa (Esc)" Click="MapCloseButton_Click" IsTabStop="False" />
                <TextBlock Grid.Column="1" Text="📍 Mappa" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button x:Name="MapFiltroSelezionateButton" Content="Solo selezionate" Click="MapFiltroSelezionate_Click" IsTabStop="False" />
                    <Button x:Name="MapFiltroTutteButton" Content="Tutte le foto" Click="MapFiltroTutte_Click" IsTabStop="False" />
                    <TextBlock x:Name="MapStatusText" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" Margin="0,0,12,0">
                    <!-- I nomi dei luoghi si chiedono a OpenStreetMap (le coordinate escono dal PC): disattivabile. -->
                    <CheckBox x:Name="MapNomiLuoghiCheck" Content="Nomi dei luoghi (OpenStreetMap)" Click="NomiLuoghiCheck_Click" IsTabStop="False"
                              ToolTipService.ToolTip="Mostra il nome del posto (es. Polignano a Mare, Puglia). Le coordinate vengono inviate a openstreetmap.org; i nomi restano salvati nella cartella." />
                    <Button x:Name="MapRescanButton" Content="🔄 Riscansiona GPS" Click="MapRescanButton_Click" IsTabStop="False" />
                </StackPanel>
                <Button Grid.Column="4" Content="✕" Width="36" Height="36" Padding="0" Click="MapCloseButton_Click" IsTabStop="False" />
            </Grid>

            <Grid Grid.Row="1">
                <WebView2 x:Name="MapWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <ProgressRing x:Name="MapLoadingRing" Width="48" Height="48" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <InfoBar x:Name="MapInfoBar" IsOpen="False" Severity="Informational" Title="Nessuna foto" Message="Nessuna foto con coordinate GPS trovata in questa cartella." HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>

    </Grid>

    </SplitView>

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

</Window>
