<Window
    x:Class="WFastPic.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WFastPic.App">

    <Grid RowDefinitions="Auto,*">


    <!--
        Barra del titolo dentro la finestra (ExtendsContentIntoTitleBar): stesso Mica del pannello
        cartelle invece della barra bianca di sistema. Nascosta a schermo intero (MainWindow.xaml.cs).
    -->
    <Grid x:Name="BarraTitolo" Grid.Row="0" Height="36" ColumnDefinitions="Auto,Auto,Auto,*" Padding="14,0,0,0">
        <Image Source="ms-appx:///Assets/app.png" Width="18" Height="18" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="WFastPic" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
        <TextBlock x:Name="BarraTitoloVersioneText" Grid.Column="2" FontSize="12" Foreground="{StaticResource TestoTerziarioBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
    </Grid>

    <!--
        Pannello cartelle stile Picasa: fisso accanto alla griglia (Inline), "le mie cartelle" per anno
        con numero di foto e periodo; "Sfoglia il PC" è secondario e si carica solo se aperto.
    -->
    <SplitView
        x:Name="RootSplitView"
        Grid.Row="1"
        DisplayMode="Inline"
        OpenPaneLength="290"
        IsPaneOpen="True"
        PanePlacement="Left"
        PaneBackground="Transparent">

        <SplitView.Pane>
            <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="6,2,4,8" RowSpacing="2">
                <!--
                    Persone stile Picasa (opzione: riconoscimento pesante, chiesto al primo uso): chi compare
                    nella cartella e i gruppi di volti simili senza nome. Clic = filtra la griglia;
                    tasto destro = dai un nome, conferma le proposte, rinomina, togli il nome, ignora.
                -->
                <Expander
                    x:Name="PersoneExpander"
                    Grid.Row="0"
                    IsExpanded="True"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Persone" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleSwitch
                                x:Name="RiconoscimentoPersoneSwitch"
                                Grid.Column="1"
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                Toggled="RiconoscimentoPersoneSwitch_Toggled"
                                ToolTipService.ToolTip="Riconoscimento delle persone (analisi in background)" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="PersoneStatoText" Foreground="#888888" FontSize="12" TextWrapping="Wrap" />
                        <Grid x:Name="PersoneAnnullaPanel" ColumnDefinitions="*,Auto" ColumnSpacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="PersoneAnnullaText" Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <HyperlinkButton Grid.Column="1" Content="Annulla" FontSize="12" Padding="0" Click="PersoneAnnulla_Click" />
                        </Grid>
                        <!--
                            Come l'elenco Persone di Picasa: tutte le persone con nome (di tutte le cartelle,
                            in ordine alfabetico) con miniatura quadrata e numero di foto, poi i gruppi senza
                            nome della cartella aperta. Chi non compare qui è attenuato: il clic apre la sua cartella.
                        -->
                        <ListView
                            x:Name="PersoneList"
                            MaxHeight="300"
                            Margin="-12,0,-12,0"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="PersoneList_ItemClick"
                            RightTapped="PersoneList_RightTapped">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate x:DataType="local:GruppoPersone">
                                            <TextBlock Text="{x:Bind Titolo}" Foreground="{StaticResource TitoloSezioneBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:PersonaUi">
                                    <Grid Padding="0,4" ColumnDefinitions="Auto,*" ColumnSpacing="10" Opacity="{x:Bind Opacita}">
                                        <Border Width="40" Height="40" CornerRadius="4" Background="#2A2A2A">
                                            <Image Source="{x:Bind Avatar}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind Nome}" Foreground="{x:Bind ColoreNome}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Dettaglio}" Foreground="#999999" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <HyperlinkButton Content="Rianalizza le persone di questa cartella" FontSize="12" Padding="0" Click="RianalizzaPersone_Click" />
                    </StackPanel>
                </Expander>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="14,8,8,6">
                    <TextBlock Text="Cartelle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Style="{StaticResource BarraButtonStyle}"
                        Click="AggiungiCartellaButton_Click"
                        ToolTipService.ToolTip="Aggiungi una cartella di foto"
                        AutomationProperties.Name="Aggiungi una cartella di foto">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                </Grid>

                <Grid Grid.Row="2">
                    <ListView
                        x:Name="ElencoCartelle"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="ElencoCartelle_ItemClick"
                        Padding="0,0,0,8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="local:GruppoAnno">
                                        <TextBlock Text="{x:Bind Titolo}" Foreground="{StaticResource TitoloSezioneBrush}" FontSize="14" FontWeight="SemiBold" Margin="2,10,0,0" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:VoceCartella">
                                <Grid Padding="8,7" CornerRadius="6" Opacity="{x:Bind Opacita}" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <!-- Cartella aperta adesso: fondo evidenziato e trattino d'accento, come la voce attiva di NavigationView. -->
                                    <Border Grid.ColumnSpan="2" Margin="-8,-7" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind IsCorrente, Mode=OneWay}" />
                                    <Border Width="3" Height="18" Margin="-8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="1.5" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsCorrente, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE8B7;" Foreground="#F2C14E" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{x:Bind Nome}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Dettaglio, Mode=OneWay}" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Periodo}" Foreground="{StaticResource TestoTerziarioBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Visibility="{x:Bind PeriodoVisibile}" />
                                    </StackPanel>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout Opening="MenuCartella_Opening">
                                            <MenuFlyoutItem Text="{x:Bind local:Etichette.RicaricaCartella}" Click="CartellaRicarica_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE72C;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind local:Etichette.ApriInEsplora}" Click="CartellaApriInEsplora_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xEC50;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind local:Etichette.TogliDallElenco}" Click="CartellaRimuoviDallElenco_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE711;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <ToolTipService.ToolTip>
                                        <TextBlock Text="{x:Bind Percorso}" />
                                    </ToolTipService.ToolTip>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="PannelloCartelleVuotoText"
                        Text="Nessuna cartella ancora. Usa + oppure &quot;Sfoglia il PC&quot; per aprirne una: comparirà qui, divisa per anno."
                        Foreground="#888888"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Margin="16,8"
                        Visibility="Collapsed" />
                </Grid>

                <Expander
                    x:Name="SfogliaPcExpander"
                    Grid.Row="3"
                    Header="Sfoglia il PC"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Expanding="SfogliaPcExpander_Expanding">
                    <TreeView
                        x:Name="DirectoryTree"
                        Height="280"
                        SelectionMode="None"
                        Expanding="DirectoryTree_Expanding"
                        ItemInvoked="DirectoryTree_ItemInvoked">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="TreeViewNode">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="2,4">
                                    <FontIcon Glyph="{x:Bind ((local:DirectoryTreeEntry)Content).Icona}" Foreground="#B8D8F5" FontSize="15" />
                                    <TextBlock Text="{x:Bind ((local:DirectoryTreeEntry)Content).Nome}" Foreground="#DDDDDD" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Expander>
            </Grid>
        </SplitView.Pane>

        <Grid RowDefinitions="Auto,*,Auto">

            <!--
                Barra strumenti su tre zone: pannello + percorso a sinistra (si stringe per primo),
                vista (filtro, giorni) e azioni sulla cartella a destra, Esporta come azione principale.
            -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="8,2,12,8" SizeChanged="BarraStrumenti_SizeChanged">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        x:Name="ToggleSidebarButton"
                        Width="38"
                        Padding="0"
                        Style="{StaticResource BarraButtonStyle}"
                        Click="ToggleSidebarButton_Click"
                        ToolTipService.ToolTip="Mostra/nascondi il pannello cartelle"
                        AutomationProperties.Name="Mostra o nascondi il pannello cartelle">
                        <FontIcon Glyph="&#xE700;" FontSize="16" />
                    </Button>
                    <Button
                        x:Name="ApriCartellaButton"
                        Width="38"
                        Padding="0"
                        Style="{StaticResource BarraButtonStyle}"
                        Click="ApriCartellaButton_Click"
                        ToolTipService.ToolTip="Apri cartella…"
                        AutomationProperties.Name="Apri cartella">
                        <FontIcon Glyph="&#xE838;" FontSize="16" />
                    </Button>
                </StackPanel>
                <TextBox
                    x:Name="PercorsoTextBox"
                    Grid.Column="1"
                    MinWidth="160"
                    MaxWidth="640"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    PlaceholderText="Incolla o scrivi il percorso della cartella, poi Invio…"
                    KeyDown="PercorsoTextBox_KeyDown" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ComboBox
                        x:Name="FiltroComboBox"
                        MinWidth="140"
                        SelectedIndex="0"
                        SelectionChanged="FiltroComboBox_SelectionChanged"
                        ToolTipService.ToolTip="Filtro (Tab)"
                        AutomationProperties.Name="Filtro">
                        <ComboBoxItem Content="Tutte" />
                        <ComboBoxItem Content="Selezionate" />
                        <ComboBoxItem Content="Scarti" />
                        <ComboBoxItem Content="Geolocalizzate" />
                        <ComboBoxItem Content="Con volti" />
                        <ComboBoxItem Content="Da scartare?" />
                        <ComboBoxItem Content="Doppioni" />
                    </ComboBox>
                    <!-- Solo nel filtro «Da scartare?»: scarta in un colpo le foto mosse o venute male (con conferma). -->
                    <Button
                        x:Name="ScartaSuggeriteButton"
                        Margin="4,0,0,0"
                        Visibility="Collapsed"
                        Click="ScartaSuggeriteButton_Click"
                        ToolTipService.ToolTip="Segna come scarti tutte le foto suggerite (si possono rivedere nel filtro Scarti)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="OrangeRed" />
                            <TextBlock x:Name="ScartaSuggeriteText" Text="Scarta tutte" />
                        </StackPanel>
                    </Button>
                    <!-- Solo nel filtro «Doppioni»: in ogni gruppo tiene la copia suggerita e scarta le altre (con conferma). -->
                    <Button
                        x:Name="ScartaDoppioniButton"
                        Margin="4,0,0,0"
                        Visibility="Collapsed"
                        Click="ScartaDoppioniButton_Click"
                        ToolTipService.ToolTip="Tiene in ogni gruppo la copia suggerita e segna come scarti le altre (Shift+Space: tieni questa)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="OrangeRed" />
                            <TextBlock x:Name="ScartaDoppioniText" Text="Scarta le copie" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="FiltroPersonaButton"
                        Margin="4,0,0,0"
                        Visibility="Collapsed"
                        Click="FiltroPersonaButton_Click"
                        ToolTipService.ToolTip="Togli il filtro persona">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                            <TextBlock x:Name="FiltroPersonaText" />
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        x:Name="DividiPerGiorniToggle"
                        Margin="4,0,0,0"
                        Style="{StaticResource BarraToggleButtonStyle}"
                        Click="DividiPerGiorniToggle_Click"
                        IsTabStop="False"
                        AllowFocusOnInteraction="False"
                        ToolTipService.ToolTip="Divide la griglia per giorno di scatto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE787;" FontSize="14" />
                            <TextBlock x:Name="PerGiorniEtichetta" Text="Per giorni" />
                        </StackPanel>
                    </ToggleButton>
                    <AppBarSeparator Padding="2,0" />
                    <Button x:Name="MappaButton" Style="{StaticResource BarraButtonStyle}" Click="MappaButton_Click" ToolTipService.ToolTip="Visualizza le foto geolocalizzate sulla mappa">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE707;" FontSize="14" />
                            <TextBlock x:Name="MappaEtichetta" Text="Mappa" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GestisciScartiButton" Style="{StaticResource BarraButtonStyle}" Click="GestisciScartiButton_Click" ToolTipService.ToolTip="Gestisci scarti: Cestino, cartella Scarti/ o ripristina">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock x:Name="ScartiEtichetta" Text="Scarti" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EsportaButton" Margin="6,0,0,0" Padding="14,6" MinHeight="34" Style="{StaticResource AccentButtonStyle}" Click="EsportaButton_Click" ToolTipService.ToolTip="Esporta le foto in JPEG">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                            <TextBlock Text="Esporta…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Card scura della griglia (e della barra in basso), dietro a tutto il resto delle righe 1-2. -->
            <Border
                Grid.Row="1"
                Grid.RowSpan="2"
                Background="{StaticResource SfondoContenutoBrush}"
                BorderBrush="{StaticResource BordoContenutoBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0" />

        <ListView
            x:Name="Griglia"
            Grid.Row="1"
            SelectionMode="Single"
            IsItemClickEnabled="False"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Visible"
            ScrollViewer.VerticalScrollMode="Enabled"
            Padding="8,8,4,8"
            SelectionChanged="Griglia_SelectionChanged"
            DoubleTapped="Griglia_DoubleTapped"
            RightTapped="Griglia_RightTapped"
            ContainerContentChanging="Griglia_ContainerContentChanging"
            Loaded="Griglia_Loaded">
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemSelectedBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemSelectedPointerOverBackground" Color="#22FFFFFF" />
                <SolidColorBrush x:Key="ListViewItemSelectedPressedBackground" Color="#33FFFFFF" />
                <!-- Il trattino blu di selezione di WinUI si confondeva con la barra azzurra delle raffiche. -->
                <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="160" ItemHeight="160" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <!-- Usato solo con "Dividi per giorni" (sorgente raggruppata): intestazione per data come Picasa. -->
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="local:GruppoGiorno">
                            <TextBlock Text="{x:Bind Titolo, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Margin="2,12,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PhotoGridItem">
                    <Grid Margin="4">
                        <!-- Image dentro il Border: il CornerRadius ritaglia anche la miniatura, non solo lo sfondo. -->
                        <!-- Fondo appena visibile finché la miniatura non arriva; poi la foto "galleggia" con gli angoli arrotondati. -->
                        <Border Background="{StaticResource SfondoCellaBrush}" CornerRadius="6" />
                        <!-- Cella quadrata: girata di 90° la miniatura entra comunque. -->
                        <Border CornerRadius="4" Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <CompositeTransform Rotation="{x:Bind RotazioneMiniatura, Mode=OneWay}" ScaleX="{x:Bind ScalaXMiniatura, Mode=OneWay}" />
                            </Border.RenderTransform>
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                        </Border>
                        <Border Background="#8C000000" CornerRadius="6" Visibility="{x:Bind IsReject, Mode=OneWay}" />
                        <Border
                            BorderBrush="#FFD600"
                            BorderThickness="4"
                            Background="#1AFFD600"
                            CornerRadius="6"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                        <Border
                            Height="4"
                            VerticalAlignment="Bottom"
                            CornerRadius="0,0,6,6"
                            Background="LimeGreen"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind IsCorrenteGriglia, Mode=OneWay}" />
                        <Border
                            x:Name="SelectionBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            Tapped="SelectionBadge_Tapped"
                            DoubleTapped="SelectionBadge_DoubleTapped">
                            <FontIcon
                                Glyph="&#xE73E;"
                                Foreground="LimeGreen"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                        </Border>
                        <FontIcon
                            Glyph="&#xE711;"
                            Foreground="OrangeRed"
                            FontSize="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="6"
                            Visibility="{x:Bind IsReject, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind RatingTesto, Mode=OneWay}"
                            Foreground="Gold"
                            FontSize="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="6"
                            Visibility="{x:Bind HasRating, Mode=OneWay}" />
                        <Border
                            Width="4"
                            HorizontalAlignment="Left"
                            CornerRadius="6,0,0,6"
                            Background="#00B0FF"
                            Visibility="{x:Bind HasGroup, Mode=OneWay}" />
                        <!-- Orientamento dalla miniatura: badge nelle bande vuote, non sopra la foto. -->
                        <StackPanel Orientation="{x:Bind OrientamentoBadge, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2" Spacing="3">
                            <!-- Stesso riquadro scuro del badge GPS: un'icona bianca nuda sparisce su cieli e spiagge. -->
                            <Border
                                Background="#B3000000"
                                CornerRadius="3"
                                Padding="3,2"
                                Visibility="{x:Bind HasVideo, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind local:Etichette.LivePhoto}">
                                <FontIcon Glyph="&#xE714;" Foreground="White" FontSize="12" />
                            </Border>
                            <Border
                                Background="#B3000000"
                                CornerRadius="3"
                                Padding="3,2"
                                Visibility="{x:Bind HasGps, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind local:Etichette.FotoConGps}">
                                <FontIcon Glyph="&#xE707;" Foreground="#4FC3F7" FontSize="12" />
                            </Border>
                            <!-- Modifiche fatte nell'editor: ritaglio, raddrizzamento, colore/tono. -->
                            <Border
                                Background="#B3000000"
                                CornerRadius="3"
                                Padding="3,2"
                                Visibility="{x:Bind HaModifiche, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind local:Etichette.FotoModificata}">
                                <StackPanel Orientation="{x:Bind OrientamentoBadge, Mode=OneWay}" Spacing="4">
                                    <FontIcon Glyph="&#xE7A8;" Foreground="#FFB300" FontSize="12" Visibility="{x:Bind HaRitaglio, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE7AD;" Foreground="#FFB300" FontSize="12" Visibility="{x:Bind HaRaddrizzamento, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE790;" Foreground="#FF80AB" FontSize="12" Visibility="{x:Bind HaTono, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!--
                            In basso a destra: voto automatico (stelline vuote viola, ben diverse dalle piene
                            gialle dell'utente in basso a sinistra) e posizione nella raffica.
                        -->
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                            <Border
                                Background="#CC000000"
                                CornerRadius="3"
                                Padding="4,1"
                                Visibility="{x:Bind HasVotoAuto, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind VotoAutoDescrizione, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE7BA;" Foreground="OrangeRed" FontSize="12" Visibility="{x:Bind DaScartareSuggerita, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE77B;" Foreground="Gold" FontSize="12" Visibility="{x:Bind CiSeiTu, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE8E1;" Foreground="#00B0FF" FontSize="12" Visibility="{x:Bind MiglioreRaffica, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind VotoAutoTesto, Mode=OneWay}" Foreground="#B39DDB" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <!-- Doppione: icona copia arancione, spunta verde sulla copia da tenere. -->
                            <Border
                                Background="#CC000000"
                                CornerRadius="3"
                                Padding="4,2"
                                Visibility="{x:Bind HasDoppione, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind DoppioneDescrizione, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8C8;" Foreground="#FFAB40" FontSize="12" />
                                    <FontIcon Glyph="&#xE930;" Foreground="LimeGreen" FontSize="12" Visibility="{x:Bind MiglioreDoppione, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Background="#CC000000"
                                CornerRadius="3"
                                Padding="4,1"
                                Visibility="{x:Bind HasGroup, Mode=OneWay}">
                                <TextBlock Text="{x:Bind GruppoTesto, Mode=OneWay}" Foreground="#00B0FF" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--
            Stato vuoto: benvenuto senza cartella aperta, oppure cartella senza foto / filtro senza
            risultati (AggiornaStatoVuoto). Non intercetta il mouse: la griglia sotto resta com'è.
        -->
        <StackPanel
            x:Name="StatoVuotoPanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="440"
            Spacing="10"
            Visibility="Collapsed">
            <Image x:Name="StatoVuotoLogo" Source="ms-appx:///Assets/app.png" Width="88" Height="88" Margin="0,0,0,8" />
            <FontIcon x:Name="StatoVuotoIcona" Glyph="&#xE91B;" FontSize="48" Foreground="{StaticResource TestoTerziarioBrush}" Margin="0,0,0,8" Visibility="Collapsed" />
            <TextBlock x:Name="StatoVuotoTitolo" Text="Benvenuto in WFastPic" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock
                x:Name="StatoVuotoTesto"
                Text="Apri una cartella di foto per iniziare: scegli le migliori con Space, scarta con Canc, sistema e esporta. Le cartelle aperte restano nel pannello a sinistra, divise per anno."
                Foreground="{StaticResource TestoSecondarioBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center" />
            <Button
                x:Name="StatoVuotoApriButton"
                HorizontalAlignment="Center"
                Margin="0,10,0,0"
                Padding="18,8"
                Style="{StaticResource AccentButtonStyle}"
                Click="ApriCartellaButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                    <TextBlock Text="Apri una cartella…" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="4" Padding="14,6,8,6" BorderBrush="{StaticResource BordoContenutoBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <!-- Come Picasa: la griglia è già usabile mentre le miniature arrivano, l'avanzamento sta in basso. -->
            <StackPanel
                x:Name="MiniaturePanel"
                Grid.Column="2"
                Margin="12,0,8,0"
                Orientation="Horizontal"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock x:Name="MiniatureText" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="12" VerticalAlignment="Center" />
                <ProgressBar x:Name="MiniatureProgressBar" Width="200" Minimum="0" Maximum="1" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Solo se GitHub ha una release più nuova (MainWindow.Aggiornamenti.cs): apre la pagina di download. -->
            <HyperlinkButton
                x:Name="NuovaVersioneButton"
                Grid.Column="3"
                Padding="8,4"
                MinHeight="0"
                Visibility="Collapsed"
                IsTabStop="False"
                AllowFocusOnInteraction="False"
                Click="NuovaVersioneButton_Click"
                ToolTipService.ToolTip="Apre la pagina della nuova versione su GitHub">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE896;" FontSize="12" />
                    <TextBlock x:Name="NuovaVersioneText" FontSize="12" />
                </StackPanel>
            </HyperlinkButton>
            <!-- Le scorciatoie stavano in una riga sempre tagliata: ora per intero in un flyout. -->
            <Button
                Grid.Column="4"
                Padding="8,4"
                MinHeight="0"
                Style="{StaticResource BarraButtonStyle}"
                IsTabStop="False"
                AllowFocusOnInteraction="False"
                ToolTipService.ToolTip="Scorciatoie da tastiera">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE765;" FontSize="14" Foreground="{StaticResource TestoSecondarioBrush}" />
                    <TextBlock Text="Scorciatoie" FontSize="12" Foreground="{StaticResource TestoSecondarioBrush}" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedRight">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Text="← / →" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Foto precedente / successiva" />
                            <TextBlock Grid.Row="1" Text="Space" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Seleziona" />
                            <TextBlock Grid.Row="2" Text="Shift+Space" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Seleziona e scarta il resto della raffica" />
                            <TextBlock Grid.Row="3" Text="Canc / Backspace" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Scarta (mai cancellazione)" />
                            <TextBlock Grid.Row="4" Text="0 – 5" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Stelle" />
                            <TextBlock Grid.Row="5" Text="Tab" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Cambia filtro" />
                            <TextBlock Grid.Row="6" Text="Ctrl+A" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="Seleziona tutte le visibili" />
                            <TextBlock Grid.Row="7" Text="Shift+rotella" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="Dimensione delle miniature" />
                            <TextBlock Grid.Row="8" Text="Invio / doppio clic" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="Apri la foto" />
                            <TextBlock Grid.Row="9" Text="Nella foto" FontWeight="SemiBold" Foreground="{StaticResource TestoSecondarioBrush}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="X ritaglia · L raddrizza · U Ho fortuna · B originale · F11 schermo intero · Ctrl+Z / Ctrl+Y" Foreground="{StaticResource TestoSecondarioBrush}" TextWrapping="Wrap" MaxWidth="300" Margin="0,6,0,0" />
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button
                Grid.Column="5"
                Padding="8,4"
                MinHeight="0"
                Style="{StaticResource BarraButtonStyle}"
                IsTabStop="False"
                AllowFocusOnInteraction="False"
                Click="InformazioniButton_Click"
                ToolTipService.ToolTip="Informazioni su WFastPic">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{StaticResource TestoSecondarioBrush}" />
                    <TextBlock Text="Informazioni" FontSize="12" Foreground="{StaticResource TestoSecondarioBrush}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Viewer + editor: UserControl a parte (Viewer/ViewerView.xaml), legato alla finestra da IViewerHost. -->
        <local:ViewerView
            x:Name="Viewer"
            Grid.Row="0"
            Grid.RowSpan="3"
            Visibility="Collapsed" />

        <ContentDialog
            x:Name="DialogScarti"
            Grid.Row="0"
            Grid.RowSpan="3"
            Title="Gestisci scarti"
            CloseButtonText="Annulla"
            DefaultButton="Close">
            <StackPanel Spacing="12" MinWidth="360">
                <TextBlock x:Name="ScartiSummary" />
                <ListView x:Name="ScartiList" MaxHeight="300" SelectionMode="None" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CestinoButton" Content="Sposta nel Cestino" Click="CestinoButton_Click" />
                    <Button x:Name="SpostaInScartiButton" Content="Sposta in Scarti/" Click="SpostaInScartiButton_Click" />
                    <Button x:Name="LasciaButton" Content="Lascia (torna a Nessuno)" Click="LasciaButton_Click" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <!--
            Dialog "Esporta" sul modello di Picasa: posizione + nome della cartella esportata,
            dimensioni originali o "ridimensiona a" con slider in pixel, qualità a preset,
            filigrana. Le opzioni restano memorizzate tra un export e l'altro (ImpostazioniStore).
        -->
        <ContentDialog
            x:Name="DialogExport"
            Grid.Row="0"
            Grid.RowSpan="3"
            Title="Esporta foto"
            PrimaryButtonText="Esporta"
            CloseButtonText="Chiudi"
            DefaultButton="Primary"
            PrimaryButtonClick="DialogExport_PrimaryButtonClick"
            Closing="DialogExport_Closing">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620" Padding="0,0,14,0">
                <StackPanel Spacing="8" Width="440">
                    <TextBlock Text="Foto da esportare" FontWeight="SemiBold" />
                    <RadioButton x:Name="ExportAmbitoSelezionateRadio" GroupName="ExportAmbito" IsChecked="True" Checked="ExportOpzione_Changed" />
                    <RadioButton x:Name="ExportAmbitoTutteRadio" GroupName="ExportAmbito" Checked="ExportOpzione_Changed" />

                    <TextBlock Text="Posizione esportazione" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="ExportPosizioneTextBox" TextChanged="ExportPercorso_TextChanged" />
                        <Button Grid.Column="1" Content="Sfoglia…" Click="ExportScegliCartellaButton_Click" />
                    </Grid>
                    <TextBlock Text="Nome della cartella esportata" Foreground="#AAAAAA" FontSize="12" />
                    <TextBox x:Name="ExportNomeCartellaTextBox" TextChanged="ExportPercorso_TextChanged" />
                    <TextBlock x:Name="ExportDestinazioneText" Foreground="#888888" FontSize="11" TextWrapping="Wrap" />

                    <TextBlock Text="Dimensioni immagine" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <RadioButton x:Name="ExportOriginaleRadio" GroupName="ExportDimensioni" Content="Usa dimensioni originali" Checked="ExportOpzione_Changed" />
                    <RadioButton x:Name="ExportRidimensionaRadio" GroupName="ExportDimensioni" Content="Ridimensiona a (lato lungo):" IsChecked="True" Checked="ExportOpzione_Changed" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="28,0,0,0">
                        <Slider x:Name="ExportLatoSlider" Minimum="400" Maximum="6000" StepFrequency="16" SmallChange="16" LargeChange="400" Value="2048" ValueChanged="ExportLatoSlider_ValueChanged" VerticalAlignment="Center" />
                        <NumberBox x:Name="ExportLatoNumberBox" Grid.Column="1" Width="110" Minimum="200" Maximum="20000" Value="2048" SpinButtonPlacementMode="Compact" ValueChanged="ExportLatoNumberBox_ValueChanged" />
                        <TextBlock Grid.Column="2" Text="pixel" VerticalAlignment="Center" Foreground="#AAAAAA" />
                    </Grid>

                    <TextBlock Text="Qualità immagine" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <ComboBox x:Name="ExportQualitaCombo" Width="200" SelectedIndex="0" SelectionChanged="ExportOpzione_Changed">
                            <ComboBoxItem Content="Automatica (consigliata)" />
                            <ComboBoxItem Content="Massima" />
                            <ComboBoxItem Content="Normale" />
                            <ComboBoxItem Content="Minima" />
                            <ComboBoxItem Content="Personalizzata" />
                        </ComboBox>
                        <Slider x:Name="ExportQualitaSlider" Grid.Column="1" Minimum="40" Maximum="100" StepFrequency="1" Value="90" VerticalAlignment="Center" ValueChanged="ExportOpzione_Changed" />
                        <TextBlock x:Name="ExportQualitaText" Grid.Column="2" Width="40" VerticalAlignment="Center" Foreground="#AAAAAA" />
                    </Grid>

                    <TextBlock Text="Filigrana" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <CheckBox x:Name="ExportFiligranaCheck" Content="Aggiungi filigrana" Checked="ExportOpzione_Changed" Unchecked="ExportOpzione_Changed" />
                    <StackPanel x:Name="ExportFiligranaPanel" Spacing="8" Margin="28,0,0,0">
                        <TextBox x:Name="ExportWatermarkTextBox" PlaceholderText="es. © Mario Rossi" TextChanged="ExportPercorso_TextChanged" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="Opacità" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12" />
                            <Slider x:Name="ExportOpacitaSlider" Grid.Column="1" Minimum="10" Maximum="100" Value="50" VerticalAlignment="Center" />
                            <ComboBox x:Name="ExportPosizioneCombo" Grid.Column="2" SelectedIndex="3" Width="150">
                                <ComboBoxItem Content="Alto sinistra" />
                                <ComboBoxItem Content="Alto destra" />
                                <ComboBoxItem Content="Basso sinistra" />
                                <ComboBoxItem Content="Basso destra" />
                                <ComboBoxItem Content="Centro" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Altre opzioni" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox x:Name="ExportTagTextBox" Header="Tag (separati da virgola)" PlaceholderText="es. vacanza, puglia, 2026" />
                    <CheckBox x:Name="ExportRimuoviGpsCheck" Content="Rimuovi la posizione GPS dai file esportati" />
                    <CheckBox x:Name="ExportSostituisciCheck" Content="Sovrascrivi i file già esportati con lo stesso nome" IsChecked="True" />

                    <ProgressBar x:Name="ExportProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,8,0,0" />
                    <TextBlock x:Name="ExportStatusText" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" />
                    <ListView x:Name="ExportErroriList" MaxHeight="120" Visibility="Collapsed" SelectionMode="None" FontSize="12" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <Grid
            x:Name="CaricamentoOverlay"
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#99000000"
            Visibility="Collapsed">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="440"
                Padding="28,24"
                CornerRadius="8"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{StaticResource BordoContenutoBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="CaricamentoText" Text="Caricamento…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <ProgressBar x:Name="CaricamentoProgressBar" IsIndeterminate="True" Minimum="0" Maximum="1" />
                    <TextBlock x:Name="CaricamentoDettaglioText" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="13" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="MapOverlay"
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#F0101010"
            Visibility="Collapsed"
            IsTabStop="True"
            RowDefinitions="Auto,*">

            <Grid Grid.Row="0" Background="#1A1A1A" Padding="12,10" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button x:Name="MapCloseButton" Content="← Chiudi mappa (Esc)" Click="MapCloseButton_Click" IsTabStop="False" />
                <TextBlock Grid.Column="1" Text="📍 Mappa" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button x:Name="MapFiltroSelezionateButton" Content="Solo selezionate" Click="MapFiltroSelezionate_Click" IsTabStop="False" />
                    <Button x:Name="MapFiltroTutteButton" Content="Tutte le foto" Click="MapFiltroTutte_Click" IsTabStop="False" />
                    <TextBlock x:Name="MapStatusText" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" Margin="0,0,12,0">
                    <!-- I nomi dei luoghi si chiedono a OpenStreetMap (le coordinate escono dal PC): disattivabile. -->
                    <CheckBox x:Name="MapNomiLuoghiCheck" Content="Nomi dei luoghi (OpenStreetMap)" Click="NomiLuoghiCheck_Click" IsTabStop="False"
                              ToolTipService.ToolTip="Mostra il nome del posto (es. Polignano a Mare, Puglia). Le coordinate vengono inviate a openstreetmap.org; i nomi restano salvati nella cartella." />
                    <Button x:Name="MapRescanButton" Content="🔄 Riscansiona GPS" Click="MapRescanButton_Click" IsTabStop="False" />
                </StackPanel>
                <Button Grid.Column="4" Content="✕" Width="36" Height="36" Padding="0" Click="MapCloseButton_Click" IsTabStop="False" />
            </Grid>

            <Grid Grid.Row="1">
                <WebView2 x:Name="MapWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <ProgressRing x:Name="MapLoadingRing" Width="48" Height="48" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <InfoBar x:Name="MapInfoBar" IsOpen="False" Severity="Informational" Title="Nessuna foto" Message="Nessuna foto con coordinate GPS trovata in questa cartella." HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>

    </Grid>

    </SplitView>

    </Grid>

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

</Window>
