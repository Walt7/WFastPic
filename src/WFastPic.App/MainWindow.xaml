<Window
    x:Class="WFastPic.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WFastPic.App">

    <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="12,10" Background="#1A1A1A">
            <Button x:Name="ApriCartellaButton" Content="Apri cartella…" Click="ApriCartellaButton_Click" />
            <Button x:Name="GestisciScartiButton" Content="Gestisci scarti…" Click="GestisciScartiButton_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="White" />
            <TextBlock x:Name="FiltroText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#AAAAAA" />
        </StackPanel>

        <ListView
            x:Name="Griglia"
            Grid.Row="1"
            SelectionMode="Single"
            IsItemClickEnabled="False"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            PointerWheelChanged="Griglia_PointerWheelChanged"
            KeyDown="Griglia_KeyDown">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="160" ItemHeight="160" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PhotoGridItem">
                    <Grid Margin="4">
                        <Border Background="#2A2A2A" CornerRadius="4" />
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        <Border Background="#66000000" Visibility="{x:Bind IsReject, Mode=OneWay}" />
                        <FontIcon
                            Glyph="&#xE73E;"
                            Foreground="LimeGreen"
                            FontSize="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="6"
                            Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                        <FontIcon
                            Glyph="&#xE711;"
                            Foreground="OrangeRed"
                            FontSize="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="6"
                            Visibility="{x:Bind IsReject, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind RatingTesto, Mode=OneWay}"
                            Foreground="Gold"
                            FontSize="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="6"
                            Visibility="{x:Bind HasRating, Mode=OneWay}" />
                        <Border
                            Width="4"
                            HorizontalAlignment="Left"
                            Background="#FFB300"
                            Visibility="{x:Bind HasGroup, Mode=OneWay}" />
                        <Border
                            Background="#CC000000"
                            CornerRadius="3"
                            Padding="4,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="6"
                            Visibility="{x:Bind HasGroup, Mode=OneWay}">
                            <TextBlock Text="{x:Bind GruppoTesto, Mode=OneWay}" Foreground="#FFB300" FontSize="12" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Padding="12,8" Background="#1A1A1A">
            <TextBlock
                Text="←/→ naviga · Space seleziona · Shift+Space seleziona e scarta il resto della raffica · Delete scarta · 0-5 rating · Tab filtro · Ctrl+A seleziona visibili · Shift+rotella dimensione griglia"
                Foreground="#888888"
                FontSize="12" />
        </StackPanel>

        <ContentDialog
            x:Name="DialogScarti"
            Grid.Row="0"
            Grid.RowSpan="3"
            Title="Gestisci scarti"
            CloseButtonText="Annulla"
            DefaultButton="Close">
            <StackPanel Spacing="12" MinWidth="360">
                <TextBlock x:Name="ScartiSummary" />
                <ListView x:Name="ScartiList" MaxHeight="300" SelectionMode="None" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="EliminaDefinitivamenteButton" Content="Elimina definitivamente" Click="EliminaDefinitivamenteButton_Click" />
                    <Button x:Name="SpostaInScartiButton" Content="Sposta in Scarti/" Click="SpostaInScartiButton_Click" />
                    <Button x:Name="LasciaButton" Content="Lascia (torna a Nessuno)" Click="LasciaButton_Click" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>

    </Grid>

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

</Window>
