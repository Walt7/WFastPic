<UserControl
    x:Class="WFastPic.App.ViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WFastPic.App">

    <Grid
        x:Name="ViewerOverlay"
        Background="{StaticResource SfondoViewerBrush}"
        IsTabStop="True"
        RowDefinitions="Auto,*">

        <!-- Barra in alto: indietro a sinistra, nome e posizione della foto al centro, vista a destra. -->
        <Grid x:Name="ViewerBarraSuperiore" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="8,6,12,6">
            <Button
                x:Name="ViewerCloseButton"
                Style="{StaticResource BarraButtonStyle}"
                Click="ViewerCloseButton_Click"
                IsTabStop="False"
                AllowFocusOnInteraction="False"
                ToolTipService.ToolTip="Torna alla griglia (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Griglia" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ViewerStatusText" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border x:Name="ViewerVideoBadge" Padding="8,3" CornerRadius="10" Background="#33FFB300" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE714;" Foreground="#FFB300" FontSize="12" />
                        <TextBlock Text="video abbinato" Foreground="#FFB300" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="ViewerZoomText" Text="Zoom 100%" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" ToolTipService.ToolTip="Rotella per lo zoom, trascina per spostare" />
                <Button x:Name="ViewerGrigliaToggle" Content="Griglia: terzi" Style="{StaticResource BarraButtonStyle}" Click="ViewerGrigliaToggle_Click" IsTabStop="False" AllowFocusOnInteraction="False" ToolTipService.ToolTip="Griglia di composizione: terzi, metà o diagonali" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="290,*" RowDefinitions="*,Auto,Auto">

            <!-- Pannello editor stile Picasa: "Correzioni base" e "Regolazioni", su una card come il pannello cartelle. -->
            <Border
                Grid.Column="0"
                Grid.RowSpan="3"
                Margin="8,0,0,8"
                CornerRadius="8"
                Background="{StaticResource SfondoPannelloEditorBrush}"
                BorderBrush="{StaticResource BordoContenutoBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsTabStop="False">
                <StackPanel Padding="14,12" Spacing="8">
                    <!-- Nel pannello e non nella barra in alto: a schermo intero la barra sparisce, il pulsante resta. -->
                    <ToggleButton x:Name="ViewerSchermoInteroToggle" HorizontalAlignment="Stretch" Click="ViewerSchermoIntero_Click" IsTabStop="False" AllowFocusOnInteraction="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE740;" FontSize="14" />
                            <TextBlock Text="Schermo intero (F11)" />
                        </StackPanel>
                    </ToggleButton>
                    <TextBlock x:Name="ViewerPosizioneSchermoInteroText" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                    <!-- Schede a segmenti: la scheda attiva (IsChecked) prende il colore d'accento. -->
                    <Border Padding="3" CornerRadius="6" Background="{StaticResource SfondoContenutoBrush}" Margin="0,4,0,4">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                            <ToggleButton x:Name="ViewerTabBase" Grid.Column="0" Content="Correzioni base" IsChecked="True" HorizontalAlignment="Stretch" Style="{StaticResource BarraToggleButtonStyle}" Padding="6,5" FontSize="13" Click="ViewerTabBase_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                            <ToggleButton x:Name="ViewerTabTuning" Grid.Column="1" Content="Regolazioni" HorizontalAlignment="Stretch" Style="{StaticResource BarraToggleButtonStyle}" Padding="6,5" FontSize="13" Click="ViewerTabTuning_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                        </Grid>
                    </Border>

                    <!-- Modalita geometria: ritaglia + raddrizza con Applica/Annulla. -->
                    <StackPanel x:Name="PannelloGeometria" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Ritaglia e raddrizza" FontWeight="SemiBold" />
                        <Button x:Name="ViewerProporzioneToggle" Content="Proporzioni: libera" Click="ViewerProporzioneToggle_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" />
                        <TextBlock Text="Raddrizza (L)" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="12" Margin="0,4,0,0" />
                        <Grid ColumnDefinitions="*,48">
                            <Slider
                                x:Name="ViewerStraightenSlider"
                                Minimum="-15" Maximum="15" StepFrequency="0.1"
                                IsTabStop="False"
                                ValueChanged="ViewerStraightenSlider_ValueChanged" />
                            <TextBlock x:Name="ViewerAngleText" Grid.Column="1" Text="0.0°" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Button Grid.Column="0" Content="Applica (Invio)" Click="ViewerGeometriaApplica_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" IsTabStop="False" AllowFocusOnInteraction="False" />
                            <Button Grid.Column="1" Content="Annulla (Esc)" Click="ViewerGeometriaAnnulla_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" />
                        </Grid>

                        <!-- Come Picasa: ritagli già pronti come miniature; un clic posiziona il riquadro. -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBlock Text="Ritagli suggeriti" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="12" VerticalAlignment="Center" />
                            <ProgressRing x:Name="ViewerSuggerimentiAnello" Grid.Column="1" Width="14" Height="14" IsActive="False" />
                        </Grid>
                        <GridView
                            x:Name="ViewerSuggerimentiList"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="ViewerSuggerimento_ItemClick"
                            IsTabStop="False"
                            AllowFocusOnInteraction="False">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:SuggerimentoRitaglioUi">
                                    <StackPanel Width="118" Spacing="3" Padding="0,2">
                                        <Border Height="80" Background="{StaticResource SfondoContenutoBrush}" CornerRadius="4">
                                            <Image Source="{x:Bind Anteprima}" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Etichetta}" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <TextBlock x:Name="ViewerSuggerimentiVolti" Foreground="{StaticResource TestoTerziarioBrush}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Pulsanti con icona e scorciatoia a destra, allineati a sinistra come un menu. -->
                    <StackPanel x:Name="PannelloBase" Spacing="6">
                        <Button x:Name="ViewerCropButton" Click="ViewerCropButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,7" IsTabStop="False" AllowFocusOnInteraction="False">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <FontIcon Glyph="&#xE7A8;" FontSize="15" />
                                <TextBlock Grid.Column="1" Text="Ritaglia" />
                                <TextBlock Grid.Column="2" Text="X" Foreground="{StaticResource TestoTerziarioBrush}" />
                            </Grid>
                        </Button>
                        <Button x:Name="ViewerStraightenButton" Click="ViewerStraightenButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,7" IsTabStop="False" AllowFocusOnInteraction="False">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <FontIcon Glyph="&#xE7AD;" FontSize="15" />
                                <TextBlock Grid.Column="1" Text="Raddrizza" />
                                <TextBlock Grid.Column="2" Text="L" Foreground="{StaticResource TestoTerziarioBrush}" />
                            </Grid>
                        </Button>
                        <TextBlock Text="Correzione automatica" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="12" Margin="0,8,0,0" />
                        <ToggleButton x:Name="ViewerLuckyToggle" ToolTipService.ToolTip="Contrasto e colore automatici insieme" Click="ViewerLuckyToggle_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,7" IsTabStop="False" AllowFocusOnInteraction="False">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <FontIcon Glyph="&#xE945;" FontSize="15" />
                                <TextBlock Grid.Column="1" Text="Ho fortuna" />
                                <TextBlock Grid.Column="2" Text="U" Opacity="0.6" />
                            </Grid>
                        </ToggleButton>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <ToggleButton x:Name="ViewerAutoContrastToggle" ToolTipService.ToolTip="Contrasto automatico" Click="ViewerAutoContrastToggle_Click" HorizontalAlignment="Stretch" Padding="8,7" IsTabStop="False" AllowFocusOnInteraction="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE706;" FontSize="14" />
                                    <TextBlock Text="Contrasto" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="ViewerAutoColorToggle" ToolTipService.ToolTip="Colore automatico" Grid.Column="1" Click="ViewerAutoColorToggle_Click" HorizontalAlignment="Stretch" Padding="8,7" IsTabStop="False" AllowFocusOnInteraction="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE790;" FontSize="14" />
                                    <TextBlock Text="Colore" />
                                </StackPanel>
                            </ToggleButton>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PannelloTuning" Spacing="4" Visibility="Collapsed">
                        <Grid ColumnDefinitions="*,44">
                            <TextBlock Text="Luce di riempimento" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="12" />
                            <TextBlock x:Name="ViewerFillLightText" Grid.Column="1" Text="0" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="ViewerFillLightSlider" Minimum="0" Maximum="100" StepFrequency="1" IsTabStop="False" ValueChanged="ViewerTuningSlider_ValueChanged" />
                        <Grid ColumnDefinitions="*,44">
                            <TextBlock Text="Evidenzia (alte luci)" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="12" />
                            <TextBlock x:Name="ViewerHighlightsText" Grid.Column="1" Text="0" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="ViewerHighlightsSlider" Minimum="0" Maximum="100" StepFrequency="1" IsTabStop="False" ValueChanged="ViewerTuningSlider_ValueChanged" />
                        <Grid ColumnDefinitions="*,44">
                            <TextBlock Text="Ombre" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="12" />
                            <TextBlock x:Name="ViewerShadowsText" Grid.Column="1" Text="0" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="ViewerShadowsSlider" Minimum="0" Maximum="100" StepFrequency="1" IsTabStop="False" ValueChanged="ViewerTuningSlider_ValueChanged" />
                        <Grid ColumnDefinitions="*,44">
                            <TextBlock Text="Temperatura colore" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="12" />
                            <TextBlock x:Name="ViewerTemperatureText" Grid.Column="1" Text="0" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="ViewerTemperatureSlider" Minimum="-100" Maximum="100" StepFrequency="1" IsTabStop="False" ValueChanged="ViewerTuningSlider_ValueChanged" />
                        <Button Content="Azzera regolazioni" Click="ViewerTuningReset_Click" HorizontalAlignment="Stretch" Margin="0,6,0,0" IsTabStop="False" AllowFocusOnInteraction="False" />
                    </StackPanel>

                    <Rectangle Height="1" Fill="{StaticResource BordoContenutoBrush}" Margin="0,8" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button x:Name="ViewerUndoButton" Grid.Column="0" Click="ViewerUndo_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" ToolTipService.ToolTip="Annulla (Ctrl+Z)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                <TextBlock Text="Annulla" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ViewerRedoButton" Grid.Column="1" Click="ViewerRedo_Click" HorizontalAlignment="Stretch" IsTabStop="False" AllowFocusOnInteraction="False" ToolTipService.ToolTip="Ripeti (Ctrl+Y)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                                <TextBlock Text="Ripeti" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button x:Name="ViewerResetButton" Click="ViewerReset_Click" HorizontalAlignment="Stretch" Style="{StaticResource BarraButtonStyle}" IsTabStop="False" AllowFocusOnInteraction="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Ripristina originale" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Tieni premuto B per vedere l'originale" Foreground="{StaticResource TestoTerziarioBrush}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" />

                    <!--
                        Luogo, come il pannello "Luoghi" di Picasa: nome del posto, dispositivo e dati
                        di ripresa (altitudine, direzione, drone), mini-mappa con la freccia della
                        direzione. "Correggi" sposta il segnaposto; la correzione sta solo nel sidecar.
                    -->
                    <StackPanel x:Name="PannelloLuogo" Spacing="6" Margin="0,6,0,0">
                        <Rectangle Height="1" Fill="{StaticResource BordoContenutoBrush}" Margin="0,2,0,6" />
                        <TextBlock Text="Luogo" FontWeight="SemiBold" />
                        <TextBlock x:Name="ViewerLuogoNome" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock x:Name="ViewerLuogoDettagli" Foreground="{StaticResource TestoSecondarioBrush}" FontSize="11" TextWrapping="Wrap" />
                        <Border CornerRadius="6" Height="180" Background="{StaticResource SfondoContenutoBrush}" BorderBrush="{StaticResource BordoContenutoBrush}" BorderThickness="1">
                            <WebView2 x:Name="ViewerMiniMappa" />
                        </Border>
                        <TextBlock x:Name="ViewerLuogoSuggerimento" Text="Trascina il segnaposto o clicca sulla mappa nel punto giusto." Foreground="#FFB300" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                        <Grid x:Name="ViewerLuogoAzioni" ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Button x:Name="ViewerLuogoCorreggiButton" Content="Correggi" HorizontalAlignment="Stretch" Click="ViewerLuogoCorreggi_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                            <Button x:Name="ViewerLuogoRimuoviButton" Grid.Column="1" Content="Rimuovi" HorizontalAlignment="Stretch" Click="ViewerLuogoRimuovi_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                        </Grid>
                        <Grid x:Name="ViewerLuogoModifica" ColumnDefinitions="*,*" ColumnSpacing="6" Visibility="Collapsed">
                            <Button Content="Salva" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="ViewerLuogoSalva_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                            <Button Grid.Column="1" Content="Annulla" HorizontalAlignment="Stretch" Click="ViewerLuogoAnnulla_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                        </Grid>
                        <Button x:Name="ViewerLuogoRipristinaButton" Content="Ripristina la posizione del file" HorizontalAlignment="Stretch" Click="ViewerLuogoRipristina_Click" Visibility="Collapsed" IsTabStop="False" AllowFocusOnInteraction="False" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </Border>

            <!-- Background trasparente: tutta l'area (anche fuori dalla foto) riceve trascinamento e rotella. -->
            <Grid
                x:Name="ViewerArea"
                Grid.Column="1"
                Background="Transparent"
                SizeChanged="ViewerArea_SizeChanged"
                PointerPressed="ViewerArea_PointerPressed"
                PointerMoved="ViewerArea_PointerMoved"
                PointerReleased="ViewerArea_PointerReleased"
                PointerCaptureLost="ViewerArea_PointerReleased">
                <Grid x:Name="ViewerImageContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid x:Name="ViewerImageHost">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ViewerZoomTransform" ScaleX="1" ScaleY="1" />
                                <RotateTransform x:Name="ViewerRotateTransform" Angle="0" />
                                <!-- Trascinamento quando è zoomata (pixel schermo, applicato dopo lo zoom). -->
                                <TranslateTransform x:Name="ViewerPanTransform" X="0" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
                        <Image x:Name="ViewerImage" Stretch="Fill" />
                        <Border
                            x:Name="ViewerSelectionBorder"
                            BorderBrush="#FFD600"
                            BorderThickness="4"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>
                    <Canvas x:Name="ViewerCropCanvas" Background="Transparent">
                        <Rectangle x:Name="DimTop" Fill="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Rectangle x:Name="DimBottom" Fill="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Rectangle x:Name="DimLeft" Fill="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Rectangle x:Name="DimRight" Fill="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Rectangle x:Name="ThirdsV1" Width="1" Fill="#88FFFFFF" IsHitTestVisible="False" />
                        <Rectangle x:Name="ThirdsV2" Width="1" Fill="#88FFFFFF" IsHitTestVisible="False" />
                        <Rectangle x:Name="ThirdsH1" Height="1" Fill="#88FFFFFF" IsHitTestVisible="False" />
                        <Rectangle x:Name="ThirdsH2" Height="1" Fill="#88FFFFFF" IsHitTestVisible="False" />
                        <Line x:Name="DiagLine1" Stroke="#88FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                        <Line x:Name="DiagLine2" Stroke="#88FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                        <Border x:Name="CropRectBorder" Tag="M" BorderBrush="#FFB300" BorderThickness="2" Background="#11FFB300" Visibility="Collapsed" />
                    </Canvas>
                    <!-- Come nella griglia: icona video sull'angolo della foto, riquadro scuro per restare leggibile. -->
                    <Border
                        x:Name="ViewerFotoVideoBadge"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="10"
                        Padding="6,4"
                        CornerRadius="4"
                        Background="#B3000000"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <FontIcon Glyph="&#xE714;" Foreground="White" FontSize="18" />
                    </Border>
                </Grid>
            </Grid>

            <!--
                Correzione della posizione a mappa grande (al posto della foto): mappa o satellite,
                zoom da strada, segnaposto trascinabile o clic nel punto giusto. Salva/Annulla in alto.
            -->
            <Grid x:Name="ViewerMappaGrandeOverlay" Grid.Column="1" Grid.RowSpan="3" Margin="8,0,8,8" CornerRadius="8" Background="{StaticResource SfondoViewerBrush}" RowDefinitions="Auto,*" Visibility="Collapsed">
                <Grid Background="{StaticResource SfondoPannelloEditorBrush}" Padding="14,10" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Correggi la posizione" FontWeight="SemiBold" />
                        <TextBlock x:Name="ViewerMappaGrandeInfo" Text="Trascina il segnaposto o clicca nel punto giusto. In alto a destra: mappa o satellite." Foreground="{StaticResource TestoSecondarioBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Salva posizione" Style="{StaticResource AccentButtonStyle}" Click="ViewerLuogoSalva_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                    <Button Grid.Column="2" Content="Annulla (Esc)" Click="ViewerLuogoAnnulla_Click" IsTabStop="False" AllowFocusOnInteraction="False" />
                </Grid>
                <WebView2 x:Name="ViewerMappaGrande" Grid.Row="1" />
            </Grid>

        <!--
            Filmstrip stile Picasa: la foto in osservazione è sempre al centro (Padding calcolato in
            AggiornaFilmstrip), più grande, a piena opacità, con bordo bianco e la stessa linea verde
            "corrente" della griglia; le altre sono attenuate. Colori coerenti con la griglia:
            giallo = selezionata, azzurro a sinistra = stessa raffica, verde sotto = corrente.
            Niente scroll e niente focus: le frecce restano al viewer.
        -->
        <ListView
            x:Name="Filmstrip"
            Grid.Column="1"
            Grid.Row="1"
            Height="136"
            Background="Transparent"
            SelectionMode="None"
            IsTabStop="False"
            AllowFocusOnInteraction="False"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.HorizontalScrollMode="Disabled"
            IsItemClickEnabled="True"
            ItemClick="Filmstrip_ItemClick"
            SizeChanged="Filmstrip_SizeChanged">
            <ListView.ItemContainerStyle>
                <!-- Contenitore senza padding/larghezza minima: il calcolo del centro usa le misure esatte. -->
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="VerticalContentAlignment" Value="Bottom" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PhotoGridItem">
                    <StackPanel Margin="4,0" Spacing="3" VerticalAlignment="Bottom">
                        <Grid
                            Width="{x:Bind DimensioneFilmstrip, Mode=OneWay}"
                            Height="{x:Bind DimensioneFilmstrip, Mode=OneWay}"
                            Opacity="{x:Bind OpacitaFilmstrip, Mode=OneWay}">
                            <Border Background="{StaticResource SfondoCellaBrush}" CornerRadius="4">
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                            </Border>
                            <Border BorderBrush="#FFD600" BorderThickness="3" CornerRadius="4" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                            <Border Width="4" HorizontalAlignment="Left" CornerRadius="4,0,0,4" Background="#00B0FF" Visibility="{x:Bind EvidenziaGruppoViewer, Mode=OneWay}" />
                            <Border BorderBrush="White" BorderThickness="3" CornerRadius="4" Visibility="{x:Bind IsCorrenteViewer, Mode=OneWay}" />
                            <FontIcon Glyph="&#xE73E;" Foreground="LimeGreen" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                            <FontIcon Glyph="&#xE711;" Foreground="OrangeRed" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Visibility="{x:Bind IsReject, Mode=OneWay}" />
                            <Border
                                Background="#B3000000"
                                CornerRadius="3"
                                Padding="2,1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="6,0,0,4"
                                Visibility="{x:Bind HasVideo, Mode=OneWay}">
                                <FontIcon Glyph="&#xE714;" Foreground="White" FontSize="10" />
                            </Border>
                            <!-- Modifiche: si aggiornano subito mentre si lavora sulla foto nell'editor. -->
                            <Border
                                Background="#B3000000"
                                CornerRadius="3"
                                Padding="2,1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,6,4"
                                Visibility="{x:Bind HaModifiche, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <FontIcon Glyph="&#xE7A8;" Foreground="#FFB300" FontSize="10" Visibility="{x:Bind HaRitaglio, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE7AD;" Foreground="#FFB300" FontSize="10" Visibility="{x:Bind HaRaddrizzamento, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE790;" Foreground="#FF80AB" FontSize="10" Visibility="{x:Bind HaTono, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <!-- Spazio sempre riservato: le miniature restano allineate in basso con o senza linea. -->
                        <Grid Height="4">
                            <Border CornerRadius="2" Background="LimeGreen" Visibility="{x:Bind IsCorrenteViewer, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="ViewerHintText"
            Grid.Column="1"
            Grid.Row="2"
            Foreground="{StaticResource TestoTerziarioBrush}"
            FontSize="12"
            Padding="12,4,12,8"
            HorizontalAlignment="Center"
            TextTrimming="CharacterEllipsis"
