<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WFastPic.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Versione dell'app: mostrata nel titolo della finestra. -->
    <Version>1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    Visual Studio senza carico di lavoro C++: il target GetVCInstallPath del Windows App SDK
    (Microsoft.UI.Xaml.Markup.Compiler.interop.targets) enumera $(VsInstallRoot)\VC\Tools\MSVC e
    fallisce con MSB4018 se la cartella non esiste. vcmeta.dll serve solo ai progetti C++: per un
    progetto C# basta un VCToolsInstallDir non vuoto per saltare la ricerca. Da riga di comando
    (dotnet build) VsInstallRoot è vuoto e questo blocco non si applica.
  -->
  <PropertyGroup Condition="'$(VsInstallRoot)' != '' and !Exists('$(VsInstallRoot)\VC\Tools\MSVC')">
    <VCToolsInstallDir>$(VsInstallRoot)\VC\Tools\MSVC\non-installato\</VCToolsInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\assets\icon.ico" Link="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Logo nella barra del titolo e nella schermata di benvenuto (ms-appx:///Assets/app.png). -->
    <Content Include="..\..\assets\icon-256.png" Link="Assets\app.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WFastPic.Core.Localizzazione\WFastPic.Core.Localizzazione.csproj" />
    <ProjectReference Include="..\WFastPic.Core.Library\WFastPic.Core.Library.csproj" />
    <ProjectReference Include="..\WFastPic.Core.Decoding\WFastPic.Core.Decoding.csproj" />
    <ProjectReference Include="..\WFastPic.Core.Processing\WFastPic.Core.Processing.csproj" />
    <ProjectReference Include="..\WFastPic.Core.Metadata\WFastPic.Core.Metadata.csproj" />
    <ProjectReference Include="..\WFastPic.Core.Selection\WFastPic.Core.Selection.csproj" />
    <ProjectReference Include="..\WFastPic.Core.Persistence\WFastPic.Core.Persistence.csproj" />
    <ProjectReference Include="..\WFastPic.Core.Export\WFastPic.Core.Export.csproj" />
    <ProjectReference Include="..\WFastPic.Core.Persone\WFastPic.Core.Persone.csproj" />
  </ItemGroup>

  <!--
    Un'app WinUI 3 non pacchettizzata ha bisogno, accanto all'exe, del PRI (WFastPic.App.pri) e dei file XAML
    compilati (*.xbf). "dotnet publish" non li copia: il pacchetto si chiudeva all'avvio con 0xC000027B
    (eccezione in Microsoft.UI.Xaml.dll). Li aggiungiamo noi, dalla cartella di compilazione.
  -->
  <Target Name="IncludiRisorseXamlNelPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_RisorsaXaml Include="$(OutDir)WFastPic.App.pri" />
      <_RisorsaXaml Include="$(OutDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_RisorsaXaml)">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
