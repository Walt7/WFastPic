<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
    <Platform Name="ARM64" />
  </Configurations>
  <Folder Name="/src/">
    <!-- L'app WinUI esiste solo per x64/arm64: "Any CPU" della soluzione la compila come x64. -->
    <Project Path="src/WFastPic.App/WFastPic.App.csproj">
      <Platform Solution="*|Any CPU" Project="x64" />
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|ARM64" Project="arm64" />
    </Project>
    <Project Path="src/WFastPic.Core.Decoding/WFastPic.Core.Decoding.csproj" />
    <Project Path="src/WFastPic.Core.Export/WFastPic.Core.Export.csproj" />
    <Project Path="src/WFastPic.Core.Library/WFastPic.Core.Library.csproj" />
    <Project Path="src/WFastPic.Core.Localizzazione/WFastPic.Core.Localizzazione.csproj" />
    <Project Path="src/WFastPic.Core.Metadata/WFastPic.Core.Metadata.csproj" />
    <Project Path="src/WFastPic.Core.Persistence/WFastPic.Core.Persistence.csproj" />
    <Project Path="src/WFastPic.Core.Persone/WFastPic.Core.Persone.csproj" />
    <Project Path="src/WFastPic.Core.Processing/WFastPic.Core.Processing.csproj" />
    <Project Path="src/WFastPic.Core.Selection/WFastPic.Core.Selection.csproj" />
    <Project Path="src/WFastPic.Mcp/WFastPic.Mcp.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/WFastPic.Core.Tests/WFastPic.Core.Tests.csproj" />
  </Folder>
  <Folder Name="/tools/">
    <Project Path="tools/ScanSmokeTest/ScanSmokeTest.csproj" />
  </Folder>
</Solution>
